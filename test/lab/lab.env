# shellcheck shell=bash disable=SC2034 # settings, read by lab.sh
# Settings of the drun lab (.specs/drun-lab.md). Each has its default here;
# lab.local.env (git-ignored) overrides it for one machine, LAB_* variables in
# the environment for one command.

# Image of the lab VM and of the inner containers.
LAB_IMAGE="ubuntu:24.04"
# The release under test, installed from its packages (lab.sh up --release).
LAB_RELEASE="v0.2.0"
LAB_REPO="dihedron/drun"

# LXD objects the lab creates and removes. Other labs on this host use
# 10.250 to 10.254 (10.253 is libvirt's virbr3) and 10.77, 10.78.
LAB_PROJECT="drun-lab"
LAB_NETWORK="drun-lab"
LAB_SUBNET="10.249.0.0/24"
LAB_STORAGE_POOL="drun-lab"
LAB_STORAGE_DRIVER="dir"
LAB_STORAGE_SIZE="60GiB"

# The lab VM: 6 drun nodes of 1 GiB and PostgreSQL fit in 10 GiB.
LAB_LXD_CPUS="8"
LAB_LXD_MEMORY="10GiB"
LAB_LXD_DISK="60GiB"
LAB_LXD_HOST="20"
LAB_INNER_LXD_CHANNEL="5.21/stable"
# Regions: PREFIX.1.0/24 (a), .2 (b), .3 (c).
LAB_REGION_PREFIX="10.70"

LAB_NODE_MEMORY="1GiB"
LAB_PG_MEMORY="1GiB"

# The voters (2 + 2 + 1, §8.7) and the spare.
LAB_VOTERS="drun-a1 drun-a2 drun-b1 drun-b2 drun-c1"
LAB_SPARE="drun-x"

# WAN profiles: one-way delays of a-b a-c b-c, in ms.
LAB_WAN_PROFILE="lan"
LAB_WAN_PROFILE_none="0 0 0"
LAB_WAN_PROFILE_lan="0.2 0.2 0.2"
LAB_WAN_PROFILE_wan30="15 15 15"
LAB_WAN_PROFILE_wanbad="40 40 40"

LAB_STATE_DIR=".state"
LAB_CACHE_DIR="$HOME/.cache/drun-lab"
LAB_ASSUME_YES="no"
